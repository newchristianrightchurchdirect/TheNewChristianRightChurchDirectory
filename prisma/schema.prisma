generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Church {
  id               Int      @id @default(autoincrement())
  name             String
  denomination     String?
  address          String
  city             String
  state            String
  zip              String?
  latitude         Float?
  longitude        Float?
  website          String?
  phone            String?
  email            String?
  zionistStance    String   @default("unknown") // "yes", "no", "anti", "unknown"
  abolitionStance  String   @default("unknown") // "pro_abolition", "anti", "incrementalist", "unknown"
  christianNationalism String @default("unknown") // "affirm" | "sympathetic" | "critical" | "unknown"
  eschatology      String   @default("unknown") // "postmill" | "amill" | "premill" | "dispensational" | "unknown"
  theonomy         String   @default("unknown") // "theonomic" | "sympathetic" | "non_theonomic" | "unknown"
  federalVision    String   @default("unknown") // "affirm" | "sympathetic" | "critical" | "unknown" (CREC/Moscow alignment)
  socialJusticeStance String @default("unknown") // anti-woke/CRT (Dallas Statement): "anti_crt" | "mixed" | "affirming" | "unknown"
  sexualityStance  String   @default("unknown") // Side B/Revoice axis: "traditional" | "side_b" | "affirming" | "unknown"
  genderStance     String   @default("unknown") // women's roles: "patriarchal" | "complementarian" | "egalitarian" | "unknown" (egalitarian => excluded from directory)
  researchStatus   String   @default("not_researched") // "researched" | "blocked" | "not_researched"
  researchNote     String?  // if blocked: why (dead site, JS-rendered, 403, bad record); else research source/date
  recordFlag       String?  // data-quality tags, ';'-separated: "duplicate_of:<id>" | "closed" | "in_transition" | "denom_corrected" | "denom_ambiguous" | "corrected"
  stanceBasis      String?  // "evidenced" | "denominational_default" | "mixed" — how zionist/abolition stances were determined
  sourceUrls       String?  // ';'-separated research source URLs (provenance)
  lastResearchedAt DateTime? // when stances/leadership were last verified
  theologicalNotes String?
  description      String?
  leadership       String?  // Pastor + elders, e.g. "Pastor: Jane Doe; Elders: A, B, C"
  approved         Boolean  @default(false)
  upvotes          Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Report {
  id        Int      @id @default(autoincrement())
  churchId  Int
  reason    String
  details   String?
  createdAt DateTime @default(now())
}
