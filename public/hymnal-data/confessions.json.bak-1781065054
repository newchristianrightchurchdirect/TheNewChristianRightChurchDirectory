                      "osis": "Ephesians.2_1-5",
                      "display": "Ephesians 2:1-5"
                    }
                  ]
                },
                {
                  "id": 8,
                  "refs": [
                    {
                      "osis": "Colossians.2_13",
                      "display": "Colossians 2:13"
                    }
                  ]
                },
                {
                  "id": 9,
                  "refs": [
                    {
                      "osis": "Titus.3_3-5",
                      "display": "Titus 3:3-5"
                    }
                  ]
                }
              ]
            },
            {
              "id": "c09_4",
              "label": "4",
              "question": null,
              "answer": "When God converts a sinner, and translates him into the state of grace, He freeth him from his natural bondage under sin; and, by His grace alone, enables him freely to will and to do that which is spiritually good; yet so, as that by reason of his remaining corruption, he doth not perfectly, nor only, will that which is good, but doth also will that which is evil.",
              "proofs": [
                {
                  "id": 1,
                  "refs": [
                    {
                      "osis": "John.8_34~36",
                      "display": "John 8:34,36"
                    }
                  ]
                },
                {
                  "id": 2,
                  "refs": [
                    {
                      "osis": "Romans.6_18~22",
                      "display": "Romans 6:18,22"
                    }
                  ]
                },
                {
                  "id": 3,
                  "refs": [
                    {
                      "osis": "Romans.7_15~18~19~21~23",
                      "display": "Romans 7:15,18,19,21,23"
                    }
                  ]
                },
                {
                  "id": 4,
                  "refs": [
                    {
                      "osis": "Galatians.5_17",
                      "display": "Galatians 5:17"
                    }
                  ]
                },
                {
                  "id": 5,
                  "refs": [
