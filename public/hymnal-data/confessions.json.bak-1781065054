                      "osis": "2.Corinthians.7_11",
                      "display": "2 Corinthians 7:11"
                    }
                  ]
                }
              ]
            },
            {
              "id": "c15_3",
              "label": "3",
              "question": null,
              "answer": "Although repentance be not to be rested in, as any satisfaction for sin, or any cause of the pardon thereof, which is the act of God’s free grace in Christ; yet it is of such necessity to all sinners, that none may expect pardon without it.",
              "proofs": [
                {
                  "id": 1,
                  "refs": [
                    {
                      "osis": "Ezekiel.16_61-63",
                      "display": "Ezekiel 16:61-63"
                    }
                  ]
                },
                {
                  "id": 2,
                  "refs": [
                    {
                      "osis": "Ezekiel.36_31~32",
                      "display": "Ezekiel 36:31,32"
                    }
                  ]
                },
                {
                  "id": 3,
                  "refs": [
                    {
                      "osis": "Hosea.14_2~4",
