                  "refs": [
                    {
                      "osis": "2.Timothy.1_9~10",
                      "display": "2 Timothy 1:9,10"
                    }
                  ]
                }
              ]
            },
            {
              "id": "c10_2",
              "label": "2",
              "question": null,
              "answer": "This effectual call is of God’s free and special grace alone, not from anything at all foreseen in man, who is altogether passive therein, until, being quickened and renewed by the Holy Spirit, he is thereby enabled to answer this call, and to embrace the grace offered and conveyed in it.",
              "proofs": [
                {
                  "id": 1,
                  "refs": [
