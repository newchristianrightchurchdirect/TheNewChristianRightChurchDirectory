                    }
                  ]
                },
                {
                  "id": 6,
                  "refs": [
                    {
                      "osis": "Acts.15_11",
                      "display": "Acts 15:11"
                    }
                  ]
                },
                {
                  "id": 7,
                  "refs": [
                    {
                      "osis": "Acts.16_31",
                      "display": "Acts 16:31"
                    }
                  ]
                },
                {
                  "id": 8,
                  "refs": [
                    {
                      "osis": "Acts.24_14",
                      "display": "Acts 24:14"
                    }
                  ]
                },
                {
                  "id": 9,
                  "refs": [
                    {
                      "osis": "Galatians.2_20",
                      "display": "Galatians 2:20"
                    }
                  ]
                },
                {
                  "id": 10,
                  "refs": [
                    {
                      "osis": "2.Timothy.1_12",
                      "display": "2 Timothy 1:12"
                    }
                  ]
                },
                {
                  "id": 11,
                  "refs": [
                    {
                      "osis": "Hebrews.11_13",
                      "display": "Hebrews 11:13"
                    }
                  ]
                }
              ]
            },
            {
              "id": "c14_3",
              "label": "3",
              "question": null,
              "answer": "This faith, although it be different in degrees, and may be weak or strong, yet it is in the least degree of it different in the kind or nature of it, as is all other saving grace, from the faith and common grace of temporary believers; and therefore, though it may be many times assailed and weakened, yet it gets the victory, growing up in many to the attainment of a full assurance through Christ, who is both the author and finisher of our faith.",
              "proofs": [
                {
                  "id": 1,
                  "refs": [
                    {
                      "osis": "Matthew.6_30",
                      "display": "Matthew 6:30"
                    }
                  ]
                },
                {
                  "id": 2,
                  "refs": [
                    {
                      "osis": "Romans.4_19~20",
                      "display": "Romans 4:19,20"
                    }
                  ]
                },
                {
                  "id": 3,
                  "refs": [
                    {
                      "osis": "Ephesians.6_16",
                      "display": "Ephesians 6:16"
                    }
                  ]
                },
                {
                  "id": 4,
                  "refs": [
                    {
                      "osis": "Colossians.2_2",
                      "display": "Colossians 2:2"
                    }
                  ]
                },
                {
                  "id": 5,
                  "refs": [
                    {
                      "osis": "Hebrews.5_13~14",
                      "display": "Hebrews 5:13,14"
                    }
                  ]
                },
                {
                  "id": 6,
