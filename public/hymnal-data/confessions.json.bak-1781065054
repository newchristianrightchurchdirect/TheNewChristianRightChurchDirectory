                    {
                      "osis": "Ecclesiastes.7_29",
                      "display": "Ecclesiastes 7:29"
                    }
                  ]
                },
                {
                  "id": 5,
                  "refs": [
                    {
                      "osis": "Jeremiah.17_9",
                      "display": "Jeremiah 17:9"
                    }
                  ]
                },
                {
                  "id": 6,
                  "refs": [
                    {
                      "osis": "Romans.3_10-19~23",
                      "display": "Romans 3:10-19,23"
                    }
                  ]
                },
                {
                  "id": 7,
                  "refs": [
                    {
                      "osis": "Ephesians.2_1",
                      "display": "Ephesians 2:1"
                    }
                  ]
                },
                {
                  "id": 8,
                  "refs": [
                    {
                      "osis": "Titus.1_15",
                      "display": "Titus 1:15"
                    }
                  ]
                }
              ]
            },
            {
              "id": "c06_3",
              "label": "3",
              "question": null,
              "answer": "They being the root of all mankind, the guilt of this sin was imputed, and the same death in sin, and corrupted nature, conveyed to all their posterity descending from them by ordinary generation.",
              "proofs": [
                {
                  "id": 1,
                  "refs": [
                    {
                      "osis": "Genesis.1_27~28",
                      "display": "Genesis 1:27,28"
                    }
                  ]
                },
                {
                  "id": 2,
                  "refs": [
                    {
                      "osis": "Genesis.2_16~17",
                      "display": "Genesis 2:16,17"
                    }
                  ]
                },
                {
                  "id": 3,
                  "refs": [
