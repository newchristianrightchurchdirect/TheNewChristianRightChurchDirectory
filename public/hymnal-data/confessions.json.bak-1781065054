              "label": "4",
              "question": "What is the Apocrypha?",
              "answer": "The Apocrypha is a collection of additional books written by people of the Old Covenant, and used in the Christian Church.",
              "proofs": []
            },
            {
              "id": "episc-10-5",
              "label": "5",
              "question": "Why do we call the Holy Scriptures the Word of God?",
              "answer": "We call them the Word of God because God inspired their human authors and because God still speaks to us through the Bible.",
              "proofs": []
            },
            {
              "id": "episc-10-6",
              "label": "6",
              "question": "How do we understand the meaning of the Bible?",
              "answer": "We understand the meaning of the Bible by the help of the Holy Spirit, who guides the Church in the true interpretation of the Scriptures.",
              "proofs": []
            }
          ]
        },
        {
          "number": "11",
          "title": "The Church",
          "entries": [
            {
              "id": "episc-11-1",
              "label": "1",
              "question": "What is the Church?",
              "answer": "The Church is the community of the New Covenant.",
              "proofs": []
            },
            {
              "id": "episc-11-2",
              "label": "2",
              "question": "How is the Church described in the Bible?",
              "answer": "The Church is described as the Body of which Jesus Christ is the Head and of which all baptized persons are members. It is called the People of God, the New Israel, a holy nation, a royal priesthood, and the pillar and ground of truth.",
              "proofs": []
            },
            {
              "id": "episc-11-3",
              "label": "3",
              "question": "How is the Church described in the creeds?",
              "answer": "The Church is described as one, holy, catholic, and apostolic.",
              "proofs": []
            },
            {
              "id": "episc-11-4",
              "label": "4",
              "question": "Why is the Church described as one?",
              "answer": "The Church is one, because it is one Body, under one Head, our Lord Jesus Christ.",
              "proofs": []
            },
            {
              "id": "episc-11-5",
              "label": "5",
              "question": "Why is the Church described as holy?",
              "answer": "The Church is holy, because the Holy Spirit dwells in it, consecrates its members, and guides them to do God’s work.",
              "proofs": []
            },
            {
              "id": "episc-11-6",
              "label": "6",
              "question": "Why is the Church described as catholic?",
              "answer": "The Church is catholic, because it proclaims the whole Faith to all people, to the end of time.",
              "proofs": []
            },
            {
              "id": "episc-11-7",
              "label": "7",
              "question": "Why is the Church described as apostolic?",
              "answer": "The Church is apostolic, because it continues in the teaching and fellowship of the apostles and is sent to carry out Christ’s mission to all people.",
              "proofs": []
            },
            {
              "id": "episc-11-8",
              "label": "8",
              "question": "What is the mission of the Church?",
              "answer": "The mission of the Church is to restore all people to unity with God and each other in Christ.",
              "proofs": []
            },
            {
              "id": "episc-11-9",
              "label": "9",
              "question": "How does the Church pursue its mission?",
              "answer": "The Church pursues its mission as it prays and worships, proclaims the Gospel, and promotes justice, peace, and love.",
              "proofs": []
            },
            {
              "id": "episc-11-10",
              "label": "10",
              "question": "Through whom does the Church carry out its mission?",
              "answer": "The Church carries out its mission through the ministry of all its members.",
              "proofs": []
            }
