                      "display": "Romans 7:5,7,8,14,17,18,23,25"
                    }
                  ]
                },
                {
                  "id": 4,
                  "refs": [
                    {
                      "osis": "Galatians.5_17",
                      "display": "Galatians 5:17"
                    }
                  ]
                },
                {
                  "id": 5,
                  "refs": [
                    {
                      "osis": "James.3_2",
                      "display": "James 3:2"
                    }
                  ]
                },
                {
                  "id": 6,
                  "refs": [
                    {
                      "osis": "1.John.1_8~10",
                      "display": "1 John 1:8,10"
                    }
                  ]
                }
              ]
            },
            {
              "id": "c06_6",
              "label": "6",
              "question": null,
              "answer": "Every sin, both original and actual, being a transgression of the righteous law of God, and contrary thereunto, doth, in its own nature, bring guilt upon the sinner, whereby he is bound over to the wrath of God, and curse of the law, and so made subject to death, with all miseries spiritual, temporal, and eternal.",
              "proofs": [
