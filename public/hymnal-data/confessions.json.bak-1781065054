                    }
                  ]
                },
                {
                  "id": 5,
                  "refs": [
                    {
                      "osis": "1.Corinthians.7_2~9~23",
                      "display": "1 Corinthians 7:2,9,23"
                    }
                  ]
                },
                {
                  "id": 6,
