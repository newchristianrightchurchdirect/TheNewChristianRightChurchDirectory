        {
          "number": "16",
          "title": "Of Good Works",
          "entries": [
            {
              "id": "c16_1",
              "label": "1",
              "question": null,
              "answer": "Good works are only such as God hath commanded in His holy Word, and not such as, without the warrant thereof, are devised by men, out of blind zeal, or upon any pretence of good intention.",
