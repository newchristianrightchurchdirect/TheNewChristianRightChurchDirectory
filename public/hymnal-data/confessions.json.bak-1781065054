                {
                  "id": 7,
                  "refs": [
                    {
                      "osis": "Ephesians.1_7",
                      "display": "Ephesians 1:7"
                    }
                  ]
                }
              ]
            },
            {
              "id": "c15_4",
              "label": "4",
              "question": null,
              "answer": "As there is no sin so small, but it deserves damnation; so there is no sin so great, that it can bring damnation upon those who truly repent.",
              "proofs": [
                {
                  "id": 1,
                  "refs": [
                    {
                      "osis": "Isaiah.1_16~18",
                      "display": "Isaiah 1:16,18"
                    }
                  ]
                },
                {
                  "id": 2,
                  "refs": [
                    {
                      "osis": "Isaiah.55_7",
                      "display": "Isaiah 55:7"
                    }
                  ]
                },
                {
                  "id": 3,
                  "refs": [
                    {
                      "osis": "Matthew.12_36",
                      "display": "Matthew 12:36"
                    }
