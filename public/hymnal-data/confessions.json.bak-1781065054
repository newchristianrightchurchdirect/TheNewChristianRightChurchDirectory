                    }
                  ]
                },
                {
                  "id": 9,
                  "refs": [
                    {
                      "osis": "Colossians.1_21",
                      "display": "Colossians 1:21"
                    }
                  ]
                },
                {
                  "id": 10,
                  "refs": [
                    {
                      "osis": "James.1_14~15",
                      "display": "James 1:14,15"
                    }
                  ]
                }
              ]
            },
            {
              "id": "c06_5",
              "label": "5",
              "question": null,
              "answer": "This corruption of nature, during this life, doth remain in those that are regenerated; and although it be, through Christ, pardoned, and mortified, yet both itself, and all the motions thereof, are truly and properly sin.",
              "proofs": [
                {
                  "id": 1,
                  "refs": [
                    {
                      "osis": "Proverbs.20_9",
                      "display": "Proverbs 20:9"
                    }
                  ]
                },
                {
                  "id": 2,
                  "refs": [
                    {
                      "osis": "Ecclesiastes.7_20",
