                      "display": "Nehemiah 13:22"
                    }
                  ]
                },
                {
                  "id": 2,
                  "refs": [
                    {
                      "osis": "Job.9_2~3",
                      "display": "Job 9:2,3"
                    }
                  ]
                },
                {
                  "id": 3,
                  "refs": [
                    {
                      "osis": "Luke.17_10",
