                      "osis": "Romans.5_12~15-19",
                      "display": "Romans 5:12,15-19"
                    }
                  ]
                },
                {
                  "id": 9,
                  "refs": [
                    {
                      "osis": "1.Corinthians.15_21~22~49",
                      "display": "1 Corinthians 15:21,22,49"
                    }
                  ]
                }
              ]
            },
            {
              "id": "c06_4",
              "label": "4",
              "question": null,
              "answer": "From this original corruption, whereby we are utterly indisposed, disabled, and made opposite to all good, and wholly inclined to all evil, do proceed all actual transgressions.",
              "proofs": [
                {
                  "id": 1,
                  "refs": [
                    {
                      "osis": "Genesis.6_5",
                      "display": "Genesis 6:5"
                    }
                  ]
                },
                {
                  "id": 2,
                  "refs": [
                    {
                      "osis": "Genesis.8_21",
                      "display": "Genesis 8:21"
                    }
                  ]
                },
                {
                  "id": 3,
                  "refs": [
                    {
                      "osis": "Matthew.15_19",
