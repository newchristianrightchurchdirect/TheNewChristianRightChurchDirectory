                    }
                  ]
                },
                {
                  "id": 11,
                  "refs": [
                    {
                      "osis": "Colossians.2_11~12",
                      "display": "Colossians 2:11,12"
                    }
                  ]
                }
              ]
            },
            {
              "id": "c28_5",
              "label": "5",
              "question": null,
              "answer": "Although it be a great sin to condemn or neglect this ordinance, yet grace and salvation are not so inseparably annexed unto it, as that no person can be regenerated, or saved, without it: or, that all that are baptised are undoubtedly regenerated.",
              "proofs": [
