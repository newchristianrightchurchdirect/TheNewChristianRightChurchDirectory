                      "osis": "Song.of.Solomon.5_2~3~6",
                      "display": "Song of Solomon 5:2,3,6"
                    }
                  ]
                },
                {
                  "id": 8,
                  "refs": [
                    {
                      "osis": "Lamentations.3_26-31",
                      "display": "Lamentations 3:26-31"
                    }
