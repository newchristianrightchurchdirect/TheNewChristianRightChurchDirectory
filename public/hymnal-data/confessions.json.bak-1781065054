                      "display": "Philippians 2:13"
                    }
                  ]
                },
                {
                  "id": 6,
                  "refs": [
                    {
                      "osis": "Colossians.1_13",
                      "display": "Colossians 1:13"
                    }
                  ]
                }
              ]
            },
            {
              "id": "c09_5",
              "label": "5",
              "question": null,
              "answer": "The will of man is made perfectly and immutably free to good alone, in the state of glory only.",
