                      "display": "1 Corinthians 12:13"
                    }
                  ]
                },
                {
                  "id": 6,
                  "refs": [
                    {
                      "osis": "Galatians.3_27",
                      "display": "Galatians 3:27"
                    }
                  ]
                },
                {
                  "id": 7,
                  "refs": [
                    {
                      "osis": "Colossians.2_11~12",
                      "display": "Colossians 2:11,12"
                    }
                  ]
                },
                {
                  "id": 8,
                  "refs": [
                    {
                      "osis": "Titus.3_5",
                      "display": "Titus 3:5"
                    }
                  ]
                }
              ]
            },
            {
              "id": "c28_2",
              "label": "2",
              "question": null,
              "answer": "The outward element to be used in this sacrament is water, wherewith the party is to be baptised, in the name of the Father, and of the Son, and of the Holy Ghost, by a minister of the Gospel, lawfully called thereunto.",
              "proofs": [
                {
                  "id": 1,
                  "refs": [
                    {
                      "osis": "Matthew.3_11",
                      "display": "Matthew 3:11"
                    }
                  ]
                },
                {
                  "id": 2,
                  "refs": [
                    {
                      "osis": "Matthew.28_19~20",
                      "display": "Matthew 28:19,20"
                    }
                  ]
                },
                {
                  "id": 3,
                  "refs": [
                    {
                      "osis": "John.1_33",
                      "display": "John 1:33"
                    }
                  ]
                }
              ]
            },
            {
              "id": "c28_3",
              "label": "3",
              "question": null,
              "answer": "Dipping of the person into the water is not necessary; but Baptism is rightly administered by pouring, or sprinkling water upon the person.",
              "proofs": [
                {
                  "id": 1,
                  "refs": [
                    {
                      "osis": "Mark.7_4",
                      "display": "Mark 7:4"
                    }
                  ]
                },
                {
                  "id": 2,
                  "refs": [
                    {
                      "osis": "Acts.2_41",
                      "display": "Acts 2:41"
                    }
                  ]
                },
                {
                  "id": 3,
                  "refs": [
                    {
                      "osis": "Acts.16_33",
                      "display": "Acts 16:33"
                    }
                  ]
                },
                {
                  "id": 4,
                  "refs": [
                    {
                      "osis": "Hebrews.9_10~19-22",
                      "display": "Hebrews 9:10,19-22"
                    }
                  ]
                }
              ]
            },
            {
              "id": "c28_4",
              "label": "4",
              "question": null,
              "answer": "Not only those that do actually profess faith in and obedience unto Christ, but also the infants of one, or both, believing parents, are to be baptised.",
              "proofs": [
