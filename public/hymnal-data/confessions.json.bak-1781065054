          "entries": [
            {
              "id": "a1_1",
              "label": "1",
              "question": null,
              "answer": "We all believe with the heart and confess with the mouth that there is one only simple and spiritual Being, which we call God; and that He is eternal, incomprehensible, invisible, immutable, infinite, almighty, perfectly wise, just, good, and the overflowing fountain of all good.",
              "proofs": []
