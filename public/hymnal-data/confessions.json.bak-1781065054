                {
                  "id": 6,
                  "refs": [
                    {
                      "osis": "1.Peter.1_2",
                      "display": "1 Peter 1:2"
                    }
                  ]
                }
              ]
            },
            {
              "id": "c11_5",
              "label": "5",
              "question": null,
              "answer": "God doth continue to forgive the sins of those that are justified, and although they can never fall from the state of justification, yet they may, by their sins, fall under God’s fatherly displeasure; and in that condition they have not usually the light of his countenance restored unto them, until they humble themselves, confess their sins, beg pardon, and renew their faith and repentance.",
              "proofs": [
                {
                  "id": 1,
                  "refs": [
