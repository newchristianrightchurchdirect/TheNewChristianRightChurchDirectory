                      "osis": "Romans.1_24-26~28",
                      "display": "Romans 1:24-26,28"
                    }
                  ]
                },
                {
                  "id": 9,
                  "refs": [
                    {
                      "osis": "Romans.11_7~8",
                      "display": "Romans 11:7,8"
                    }
                  ]
                },
                {
                  "id": 10,
                  "refs": [
                    {
                      "osis": "2.Thessalonians.2_10-12",
                      "display": "2 Thessalonians 2:10-12"
                    }
                  ]
