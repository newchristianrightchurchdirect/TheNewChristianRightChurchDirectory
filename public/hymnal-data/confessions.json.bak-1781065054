                      "osis": "Matthew.3_17",
                      "display": "Matthew 3:17"
                    }
                  ]
                },
                {
                  "id": 4,
                  "refs": [
                    {
                      "osis": "Romans.3_24~26",
                      "display": "Romans 3:24,26"
                    }
                  ]
                },
                {
                  "id": 5,
