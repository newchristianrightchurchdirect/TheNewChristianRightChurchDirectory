        {
          "number": 1,
          "isChorus": false,
          "text": "Come, Thou Almighty King,\nhelp us Thy name to sing;\nhelp us to praise:\nFather, all glorious,\no'er all victorious,\ncome, and reign over us,\nAncient of Days."
        },
        {
